{
  "source": "Health Canada - Dietary Reference Intakes: Reference Values for Elements",
  "url": "https://www.canada.ca/en/health-canada/services/food-nutrition/healthy-eating/dietary-reference-intakes/tables/reference-values-elements.html",
  "page_last_updated": "2025-11-19",
  "notes": {
    "general": "These are reference values for normal, apparently healthy individuals eating a typical mixed North American diet. An individual may have physiological, health, or lifestyle characteristics that may require tailoring of specific nutrient values.",
    "abbreviations": {
      "EAR": "Estimated Average Requirement",
      "RDA": "Recommended Dietary Allowance",
      "AI": "Adequate Intake (used when RDA cannot be determined; bolded values without a corresponding EAR represent AI)",
      "UL": "Tolerable Upper Intake Level",
      "ND": "Not Determined (due to lack of data on adverse effects, or insufficient data to set a requirement; caution needed at high intake)",
      "CDRR": "Chronic Disease Risk Reduction intake (sodium)"
    },
    "table_footnotes": {
      "footnote_16": "Arsenic - no EAR, RDA, AI, or UL has been established; the AI/UL are ND because there is no evidence of arsenic being an essential nutrient for humans.",
      "footnote_17": "There is not sufficient evidence in humans to set a UL for this life stage group.",
      "footnote_18": "Iron requirements for vegetarians are 1.8 times higher than for those who consume meat, due to the lower bioavailability of iron from plant sources.",
      "footnote_19": "The UL for magnesium represents intake from pharmacological agents or fortified foods only and does not include intake from food or water.",
      "footnote_20": "There is no established EAR or RDA for silicon; data are insufficient.",
      "footnote_21": "There is not sufficient evidence in humans to set a UL for this nutrient/life stage group; source of intake should be from food only to avoid high levels of intake.",
      "footnote_22": "There is no established EAR or RDA for vanadium; the UL is based on adults only, and applies only to vanadium as a supplement; there is no justification for vanadium supplementation by healthy individuals.",
      "footnote_23": "Zinc requirements for vegetarians may be higher due to lower bioavailability of zinc from plant sources.",
      "footnote_24": "There is not sufficient evidence in humans to set a UL for potassium.",
      "footnote_25": "CDRR = Chronic Disease Risk Reduction intake; intake above this level is associated with increased risk of chronic disease (sodium).",
      "footnote_26": "Sodium AI reflects the minimum amount needed to replace sweat losses in unacclimatized individuals and to provide for adequate intakes of other nutrients; the CDRR is the level intake above which is associated with increased risk of chronic disease.",
      "footnote_27": "CDRR values for sodium apply to generally healthy individuals ages 1 year and older; reduction of sodium intake, even among those consuming amounts below the CDRR, is likely to reduce chronic disease risk.",
      "footnote_28": "There is no established EAR, RDA, AI, or UL for sulfate; sulfate is not generally considered a nutrient of concern.",
      "footnote_asterisk": "Indicates the value is an Adequate Intake (AI), not an RDA.",
      "footnote_a": "For calcium, infant values based on AI derived from human milk intake.",
      "footnote_g": "Iron RDA for females aged 9-70y reflects menstrual losses where applicable; post-menopausal values (51-70y, >70y) are lower.",
      "footnote_h": "Sodium CDRR set specifically for children's age brackets 1-3y, 4-8y, 9-13y, and 14-18y."
    }
  },
