  "source": "Health Canada - Dietary Reference Intakes: Reference Values for Macronutrients",
  "url": "https://www.canada.ca/en/health-canada/services/food-nutrition/healthy-eating/dietary-reference-intakes/tables/reference-values-macronutrients.html",
  "page_last_updated": "2025-11-19",
  "notes": {
    "general": "These are reference values for normal, apparently healthy individuals eating a typical mixed North American diet. An individual may have physiological, health, or lifestyle characteristics that may require tailoring of specific nutrient values.",
    "abbreviations": {
      "EAR": "Estimated Average Requirement",
      "RDA": "Recommended Dietary Allowance",
      "AI": "Adequate Intake (used when RDA cannot be determined; bolded values without a corresponding EAR represent AI)",
      "UL": "Tolerable Upper Intake Level",
      "ND": "Not Determined (either due to lack of data on adverse effects, or because a UL is not applicable/needed for this nutrient)",
      "AMDR": "Acceptable Macronutrient Distribution Range (a range of intake for a particular energy source associated with reduced risk of chronic disease while providing adequate intakes of essential nutrients)"
    },
    "table_footnotes": {
      "footnote_29": "ULs have not been determined for carbohydrate, protein, total fat, linoleic acid, alpha-linolenic acid, fibre, or water; high intakes of these nutrients from food have not been associated with adverse effects in generally healthy individuals, so ND is shown for these ULs.",
      "footnote_30": "Protein RDA/AI is based on a reference body weight; the RDA/AI in g/day is calculated by multiplying the g/kg/day value by the reference weight for that age/sex group.",
      "footnote_31": "See footnote 30.",
      "footnote_32": "Total Fibre AI values are based on median total energy intake within each age/sex group.",
      "footnote_33": "See footnote 32.",
      "footnote_34": "Total Water AI includes all water contained in food, beverages, and drinking water.",
      "footnote_asterisk": "Value is an Adequate Intake (AI), not an RDA/EAR-derived requirement.",
      "footnote_i": "Protein requirements for pregnancy reflect additional needs for maternal and fetal tissue accretion; the same EAR/RDA (g/kg/day and g/day) values apply across all three pregnancy age brackets."
    },
    "additional_macronutrient_recommendations": {
      "saturated_fatty_acids": "As low as possible while consuming a nutritionally adequate diet",
      "trans_fatty_acids": "As low as possible while consuming a nutritionally adequate diet",
      "dietary_cholesterol": "As low as possible while consuming a nutritionally adequate diet",
      "added_sugars": {
        "recommendation": "Limit to no more than 25% of total energy",
        "note": "Although there were insufficient data to set a UL for added sugars, this maximal intake level is suggested to prevent the displacement of foods that are major sources of essential micronutrients."
      }
    },
    "protein_quality_scoring_pattern": {
      "description": "Reference amino acid pattern for use in evaluating the quality of food proteins using the protein digestibility corrected amino acid score (PDCAAS). Based on estimated average requirements for both indispensable amino acids and for total protein for 1 to 3 year olds.",
      "applicable_age": "1 year and older",
      "unit": "mg amino acid / g protein",
