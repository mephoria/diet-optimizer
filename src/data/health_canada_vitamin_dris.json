      "RDA": "Recommended Dietary Allowance",
      "AI": "Adequate Intake (used when RDA cannot be determined; bolded values without a corresponding EAR represent AI)",
      "UL": "Tolerable Upper Intake Level",
      "ND": "Not Determined (due to lack of data on adverse effects; caution needed at high intake)",
      "RAE": "Retinol Activity Equivalents",
      "NE": "Niacin Equivalents",
      "DFE": "Dietary Folate Equivalents"
    }
